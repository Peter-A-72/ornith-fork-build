diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 32e540e..2196ff6 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -64,6 +64,17 @@ if (GGML_OPENMP)
     endif()
 endif()
 
+# The hot expert cache calls the CUDA runtime directly, so llama itself needs the CUDA headers and runtime.
+if (GGML_CUDA)
+    find_package(CUDAToolkit REQUIRED)
+    target_include_directories(llama PRIVATE ${CUDAToolkit_INCLUDE_DIRS})
+    if (GGML_STATIC)
+        target_link_libraries(llama PRIVATE CUDA::cudart_static)
+    else()
+        target_link_libraries(llama PRIVATE CUDA::cudart)
+    endif()
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
